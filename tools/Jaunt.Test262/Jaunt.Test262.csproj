<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(JauntRunnerFramework)' == ''">net10.0</TargetFramework><TargetFramework Condition="'$(JauntRunnerFramework)' != ''">$(JauntRunnerFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Jaunt/Jaunt.csproj" />
  </ItemGroup>
</Project>
