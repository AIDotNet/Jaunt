<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(JauntRunnerFramework)' == ''">net10.0</TargetFramework><TargetFramework Condition="'$(JauntRunnerFramework)' != ''">$(JauntRunnerFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Jaunt/Jaunt.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <!-- app-local ICU 72: the system icu.dll of Windows Server 2022 lacks APIs Intl needs (see docs/FEATURES.md) -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>
</Project>
