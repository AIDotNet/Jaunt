<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net8.0;net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Jaunt</RootNamespace>
    <AssemblyName>Jaunt</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Jaunt: a fully managed, NativeAOT-compatible JavaScript engine for .NET.</Description>
    <Version>0.1.0-alpha.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Acornima" Version="1.9.1" />
    <!-- third-party license texts (Acornima BSD-3-Clause + NOTICE, Unicode V3) travel with every redistribution: at the
         package root, and as Jaunt.THIRD_PARTY_NOTICES.md in the build and publish output (NativeAOT included) of every
         application that references Jaunt, by project reference or as a NuGet content file -->
    <None Include="../../THIRD_PARTY_NOTICES.md" Link="Jaunt.THIRD_PARTY_NOTICES.md" Visible="false"
          Pack="true" PackagePath="/;contentFiles/any/any/Jaunt.THIRD_PARTY_NOTICES.md" PackageCopyToOutput="true"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jaunt.Tests" />
    <InternalsVisibleTo Include="Jaunt.Benchmarks" />
  </ItemGroup>
</Project>
